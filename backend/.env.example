DATABASE_URL=sqlite+pysqlite:///./pehchaanai.db
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Face recognition model pack:
#   buffalo_s  - lighter, faster (MobileFaceNet), ~160MB, best for CPU
#   buffalo_l  - heavier, more accurate (ResNet100 ArcFace), ~330MB
FACE_MODEL_NAME=buffalo_s
